// วางไฟล์นี้ใน Firebase Console > Firestore Database > Rules
// เนื่องจากทุกการอ่าน/เขียนทำผ่าน backend (Firebase Admin SDK ซึ่ง bypass rules อยู่แล้ว)
// จึงปิดการเข้าถึงตรงจาก client (เว็บ/แอป) ทั้งหมด กัน client ไปคุย Firestore เองข้าม backend
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
