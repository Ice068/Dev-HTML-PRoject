# ==== คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น git) ====

# Secret key สำหรับเซ็น JWT — สุ่มด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# อัลกอริทึมเซ็น JWT
ALGORITHM=HS256

# อายุ access token (นาที)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# path ไปยังไฟล์ service account key ของ Firebase (ดาวน์โหลดจาก Firebase Console > Project settings > Service accounts)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# รายชื่อ origin ที่อนุญาตให้เรียก API ได้ (คั่นด้วย comma) — ห้ามใช้ "*" ตอน production
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ตั้งเป็น false เมื่อ deploy จริงเพื่อปิด docs (/docs, /redoc)
ENABLE_DOCS=true
